<!-- ==========================================================================
     SECTION 1: HERO (Shopline-Inspired Interactive Showcase with Floating Cards)
     ========================================================================== -->
<section class="hero-shopline-section" id="hero">
  <!-- Perspective Ray Grid Lines Backdrop -->
  <div class="hero-perspective-lines" aria-hidden="true">
    <svg class="perspective-svg" viewBox="0 0 1440 900" fill="none" preserveAspectRatio="none">
      <line x1="720" y1="0" x2="160" y2="420" stroke="rgba(60, 212, 81, 0.18)" stroke-width="1" stroke-dasharray="4 4" />
      <line x1="720" y1="0" x2="260" y2="720" stroke="rgba(60, 212, 81, 0.14)" stroke-width="1" stroke-dasharray="4 4" />
      <line x1="720" y1="0" x2="480" y2="900" stroke="rgba(60, 212, 81, 0.10)" stroke-width="1" />
      <line x1="720" y1="0" x2="960" y2="900" stroke="rgba(60, 212, 81, 0.10)" stroke-width="1" />
      <line x1="720" y1="0" x2="1180" y2="460" stroke="rgba(60, 212, 81, 0.18)" stroke-width="1" stroke-dasharray="4 4" />
      <line x1="720" y1="0" x2="1280" y2="780" stroke="rgba(60, 212, 81, 0.14)" stroke-width="1" stroke-dasharray="4 4" />
    </svg>
    <div class="hero-ambient-glow"></div>
  </div>

  <div class="hero-center-content">
    <div class="hero-eyebrow-pill font-mono">
      <span class="eyebrow-pip"></span>
      <span>{{t "hero.badge"}}</span>
    </div>

    <h1 class="hero-main-title">
      {{t "hero.headlineMain"}}<br>
      <span class="hero-title-accent">{{t "hero.headlineSub"}}</span>
    </h1>

    <p class="hero-subtitle">
      {{t "hero.description"}}
    </p>

    <div class="hero-action-pills">
      <a href="/{{currentLang}}/pricing#free" class="pill-btn pill-primary">
        <span>{{t "hero.primaryCta"}}</span>
      </a>
      <a href="/{{currentLang}}/demo" class="pill-btn pill-secondary">
        <span>{{t "hero.demoLink"}}</span>
      </a>
    </div>
  </div>

  <!-- The Interactive Floating Stage (Cards Move with Float Animation + Mouse Parallax) -->
  <div class="hero-stage-container" id="hero-interactive-stage">
    
    <!-- Central Store Browser Mockup (Inspired by Shopline KRAMA) -->
    <div class="hero-central-store-window" id="hero-central-store">
      <div class="store-window-bar">
        <div class="store-dots">
          <span class="sdot red"></span>
          <span class="sdot yellow"></span>
          <span class="sdot green"></span>
        </div>
        <div class="store-url-pill font-mono">
          <span class="lock-icon">&bull;</span> aura.snaker.store
        </div>
        <div class="store-window-actions font-mono">
          <span>Search</span>
          <span class="store-cart-badge">Cart (2)</span>
        </div>
      </div>
      
      <div class="store-window-content">
        <div class="store-header-nav">
          <div class="store-nav-links">
            <span class="active">HOME</span>
            <span>SKINCARE</span>
            <span>MAKEUP</span>
            <span>BESTSELLERS</span>
          </div>
          <span class="store-brand-title">AURA</span>
          <div class="store-nav-icons font-mono">
            <span>EN</span>
            <span>USD $</span>
          </div>
        </div>

        <div class="store-hero-banner-grid">
          <div class="store-hero-watermark">AURA</div>
          <div class="store-hero-model-box">
            <div class="store-model-img-art">
              <div class="model-face-graphic">
                <span class="model-glow-ring"></span>
                <span class="model-smile-sparkle"></span>
              </div>
              <div class="model-floating-serum">
                <span class="serum-glow"></span>
                <span class="serum-cap"></span>
                <span class="serum-body font-mono">SERUM 30ml</span>
              </div>
            </div>
          </div>
          <div class="store-hero-text-side">
            <span class="store-hero-tag font-mono">ORGANIC FORMULA</span>
            <h2 class="store-hero-heading">Made To Work On All Skin Types</h2>
            <p class="store-hero-desc">
              Formulated to gently hydrate, nourish, and protect your skin's natural barrier with organic botanical oils.
            </p>
            <a href="#storefronts" class="store-hero-btn font-mono">LEARN MORE &rarr;</a>
          </div>
        </div>
      </div>
    </div>

    <!-- 4 Floating Moving Cards (Moving with continuous floating animation + mouse parallax) -->
    
    <!-- Card 1: Top-Left Social Commerce / Ad Funnel -->
    <div class="hero-floating-card card-funnel" id="float-card-1">
      <div class="fc-card-inner">
        <div class="fc-badge-bar">
          <span class="funnel-logo font-mono">F &bull; FUNNEL</span>
          <div class="social-pills">
            <span class="soc-pill fb">f</span>
            <span class="soc-pill ig">&#9679;</span>
            <span class="soc-pill g">G</span>
          </div>
        </div>
        <div class="funnel-ad-preview">
          <div class="funnel-ad-media">
            <div class="ad-tag font-mono">AUTUMN PROMO</div>
            <div class="ad-model-art">
              <div class="ad-fashion-silhouette"></div>
            </div>
          </div>
          <div class="funnel-ad-footer">
            <div class="funnel-copy-lines">
              <span class="line-1"></span>
              <span class="line-2"></span>
            </div>
            <span class="funnel-shop-btn font-mono">SHOP NOW</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Card 2: Bottom-Left Subscription & Routine Card -->
    <div class="hero-floating-card card-subscription" id="float-card-2">
      <div class="fc-card-inner">
        <div class="sub-products-row">
          <div class="sub-bottle-card">
            <div class="bottle-art emerald">
              <span class="b-cap"></span>
              <span class="b-label font-mono">CLEANSE</span>
            </div>
          </div>
          <div class="sub-bottle-card">
            <div class="bottle-art mint">
              <span class="b-cap"></span>
              <span class="b-label font-mono">HYDRATE</span>
            </div>
          </div>
        </div>
        <div class="sub-routine-title font-mono">HAIR &amp; SKIN ROUTINE</div>
        <div class="sub-tier-box">
          <div class="sub-radio-row">
            <span class="sub-radio active"></span>
            <span class="sub-text"><strong>Subscribe &amp; Save 10%</strong></span>
            <span class="sub-price font-mono"><del>$50.00</del> <strong>$45.00</strong></span>
          </div>
          <div class="sub-frequency-selector font-mono">
            <span>Delivery every 30 days</span>
            <span class="dropdown-chevron">&darr;</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Card 3: Top-Right Cart Recovery / Offer Modal -->
    <div class="hero-floating-card card-cart-recovery" id="float-card-3">
      <div class="fc-card-inner">
        <div class="cr-topbar">
          <span class="envelope-badge">&#9993;</span>
          <div class="cr-title font-mono">HANG ON!</div>
          <span class="cr-close">&times;</span>
        </div>
        <div class="cr-subtext">We've saved items in your cart</div>
        <div class="cr-items-mini">
          <span class="mini-thumb thumb-1"></span>
          <span class="mini-thumb thumb-2"></span>
          <span class="mini-thumb thumb-3"></span>
        </div>
        <div class="cr-discount-banner">
          <div class="cr-banner-text">
            <strong>Get 10% off</strong> your first order
          </div>
          <div class="cr-input-group">
            <input type="email" placeholder="Enter your email" readonly value="leyla@example.com" class="font-mono">
            <button class="cr-submit font-mono">Submit</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Card 4: Bottom-Right Member Loyalty & VIP Card -->
    <div class="hero-floating-card card-loyalty" id="float-card-4">
      <div class="fc-card-inner">
        <div class="loyalty-header">
          <div class="member-avatar">
            <span>S</span>
          </div>
          <div class="member-info">
            <div class="member-name">Hi Susan</div>
            <div class="member-tag font-mono">Exclusive Member Benefits &rarr;</div>
          </div>
          <span class="loyalty-close">&times;</span>
        </div>
        <div class="loyalty-stats-grid font-mono">
          <div class="l-stat">
            <span class="l-val">150</span>
            <span class="l-lbl">Points</span>
          </div>
          <div class="l-stat">
            <span class="l-val">$30</span>
            <span class="l-lbl">Reward</span>
          </div>
          <div class="l-stat">
            <span class="l-val">&check;</span>
            <span class="l-lbl">Free Ship</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Floating Chat Launcher Widget -->
    <div class="hero-chat-launcher" aria-hidden="true">
      <span class="chat-icon">&#128172;</span>
    </div>

  </div>
</section>

