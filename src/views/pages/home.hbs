<!-- ==========================================================================
     SECTION 9: PRICING (Free -> Subscription with 14-day trial -> Business)
     ========================================================================== -->
<section class="section section-pricing" id="pricing">
  <div class="site-container">
    <div class="section-header-editorial text-center" data-reveal>
      <span class="section-tag mono">{{t "pricing.label"}}</span>
      <h2 class="section-title text-contrast">{{t "pricing.title"}}</h2>
      <p class="section-description center-block text-contrast-sub">{{t "pricing.subtitle"}}</p>
    </div>

    <div class="pricing-tier-grid" data-reveal>
      <!-- Free Plan -->
      <div class="pricing-card free-plan" data-reveal="left">
        <div class="pricing-card-header">
          <h3 class="plan-name">{{t "pricing.freeName"}}</h3>
          <p class="plan-desc">{{t "pricing.freeDesc"}}</p>
          <div class="plan-price-wrap">
            <span class="plan-amount font-mono">{{t "pricing.freePrice"}}</span>
            <span class="plan-period">{{t "pricing.freePeriod"}}</span>
          </div>
        </div>
        <div class="plan-divider"></div>
        <ul class="plan-features-list">
          <li class="plan-feature"><span class="feat-check">&check;</span> {{t "pricing.freeFeat1"}}</li>
          <li class="plan-feature"><span class="feat-check">&check;</span> {{t "pricing.freeFeat2"}}</li>
          <li class="plan-feature"><span class="feat-check">&check;</span> {{t "pricing.freeFeat3"}}</li>
          <li class="plan-feature"><span class="feat-check">&check;</span> {{t "pricing.freeFeat4"}}</li>
        </ul>
        <div class="plan-cta-wrap">
          <a href="/{{currentLang}}/pricing#free" class="btn btn-secondary btn-full">
            <span>{{t "pricing.freeCta"}}</span>
          </a>
        </div>
      </div>

      <!-- Paid Plan (14-day trial) -->
      <div class="pricing-card paid-plan is-featured" data-reveal="scale">
        <div class="featured-badge font-mono">{{t "pricing.paidBadge"}}</div>
        <div class="pricing-card-header">
          <h3 class="plan-name">{{t "pricing.paidName"}}</h3>
          <p class="plan-desc">{{t "pricing.paidDesc"}}</p>
          <div class="plan-price-wrap">
            <span class="plan-amount highlight font-mono">{{t "pricing.paidPrice"}}</span>
            <span class="plan-period">{{t "pricing.paidPeriod"}}</span>
          </div>
        </div>
        <div class="plan-divider"></div>
        <ul class="plan-features-list">
          <li class="plan-feature"><span class="feat-check">&check;</span> {{t "pricing.paidFeat1"}}</li>
          <li class="plan-feature"><span class="feat-check">&check;</span> {{t "pricing.paidFeat2"}}</li>
          <li class="plan-feature"><span class="feat-check">&check;</span> {{t "pricing.paidFeat3"}}</li>
          <li class="plan-feature"><span class="feat-check">&check;</span> {{t "pricing.paidFeat4"}}</li>
        </ul>
        <div class="plan-cta-wrap">
          <a href="/{{currentLang}}/pricing#paid" class="btn btn-primary btn-full">
            <span>{{t "pricing.paidCta"}}</span>
            <span class="btn-arrow">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Business Plan (Separate Route) -->
      <div class="pricing-card business-route" data-reveal="right">
        <div class="pricing-card-header">
          <h3 class="plan-name">Business</h3>
          <p class="plan-desc">{{t "pricing.businessDesc"}}</p>
          <div class="plan-price-wrap">
            <span class="plan-amount font-mono">Bespoke</span>
            <span class="plan-period">Direct agreement</span>
          </div>
        </div>
        <div class="plan-divider"></div>
        <ul class="plan-features-list">
          <li class="plan-feature"><span class="feat-check">&check;</span> Dedicated architecture</li>
          <li class="plan-feature"><span class="feat-check">&check;</span> Custom ERP & data integrations</li>
          <li class="plan-feature"><span class="feat-check">&check;</span> Tailored styling requirements</li>
          <li class="plan-feature"><span class="feat-check">&check;</span> High-volume reliability</li>
        </ul>
        <div class="plan-cta-wrap">
          <a href="/{{currentLang}}/business" class="btn btn-secondary btn-full">
            <span>{{t "pricing.businessCta"}}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ==========================================================================
     SECTION 10: PURCHASE OBJECTION FAQ
     ========================================================================== -->
<section class="section section-faq" id="faq">
  <div class="site-container">
    <div class="section-header-editorial text-center" data-reveal>
      <span class="section-tag">{{t "faq.label"}}</span>
      <h2 class="section-title">{{t "faq.title"}}</h2>
      <p class="section-description center-block">{{t "faq.subtitle"}}</p>
    </div>

    <div class="faq-accordion-wrap">
      {{#each faqs}}
      <details class="faq-item" {{#if @first}}open{{/if}} data-reveal>
        <summary class="faq-question">
          <span class="faq-q-text">{{this.q}}</span>
          <span class="faq-icon">&plus;</span>
        </summary>
        <div class="faq-answer">
          <p>{{this.a}}</p>
        </div>
      </details>
      {{/each}}
    </div>
  </div>
</section>

