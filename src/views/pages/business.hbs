<div class="page-container page-business">
  <div class="page-header text-center">
    <h1 class="page-title">{{t "businessPage.title"}}</h1>
    <p class="page-lead center-block">{{t "businessPage.lead"}}</p>
  </div>

  <div class="site-container">
    <div class="business-content-grid">
      <!-- Left: Rationale and Capabilities -->
      <div class="business-info-side">
        <h2 class="biz-section-heading">{{t "businessPage.sectionTitle"}}</h2>
        <p class="biz-desc">
          {{t "businessPage.sectionDesc"}}
        </p>

        <div class="biz-focus-points">
          <div class="bfp-item">
            <span class="bfp-num mono">01</span>
            <div>
              <h3 class="bfp-title">{{t "businessPage.point1Title"}}</h3>
              <p class="bfp-text">{{t "businessPage.point1Text"}}</p>
            </div>
          </div>
          <div class="bfp-item">
            <span class="bfp-num mono">02</span>
            <div>
              <h3 class="bfp-title">{{t "businessPage.point2Title"}}</h3>
              <p class="bfp-text">{{t "businessPage.point2Text"}}</p>
            </div>
          </div>
          <div class="bfp-item">
            <span class="bfp-num mono">03</span>
            <div>
              <h3 class="bfp-title">{{t "businessPage.point3Title"}}</h3>
              <p class="bfp-text">{{t "businessPage.point3Text"}}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Direct Consultation Form -->
      <div class="business-form-side">
        <div class="biz-form-card">
          <h3 class="form-title">{{t "businessPage.formTitle"}}</h3>
          <p class="form-sub">{{t "businessPage.formSub"}}</p>

          <form id="business-contact-form" action="/api/contact" method="POST" class="standard-form" data-loading-text="{{t "forms.loading"}}" data-error-text="{{t "forms.error"}}" data-network-error-text="{{t "forms.networkError"}}">
            <input type="hidden" name="lang" value="{{currentLang}}">
            <input type="hidden" name="subject" value="Business Inquiry">

            <div class="form-group">
              <label for="biz-name">{{t "forms.name"}}</label>
              <input type="text" id="biz-name" name="name" required autocomplete="name">
            </div>

            <div class="form-group">
              <label for="biz-email">{{t "forms.workEmail"}}</label>
              <input type="email" id="biz-email" name="email" required autocomplete="email">
            </div>

            <div class="form-group">
              <label for="biz-company">{{t "forms.company"}}</label>
              <input type="text" id="biz-company" name="company" required>
            </div>

            <div class="form-group">
              <label for="biz-message">{{t "forms.requirements"}}</label>
              <textarea id="biz-message" name="message" rows="4" placeholder="{{t "forms.requirementsPlaceholder"}}" required></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-large btn-full">
              <span>{{t "businessPage.cta"}}</span>
              <span class="btn-arrow">&rarr;</span>
            </button>

            <div class="form-feedback" id="biz-form-feedback"></div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
