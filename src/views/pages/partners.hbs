<div class="page-container page-partners">
  <div class="page-header text-center">
    <span class="section-tag mono">ECOSYSTEM</span>
    <h1 class="page-title">{{t "partnersPage.title"}}</h1>
    <p class="page-lead center-block">{{t "partnersPage.lead"}}</p>
  </div>

  <div class="site-container">
    <!-- Partner Categories -->
    <div class="partner-categories-grid">
      <div class="partner-cat-card">
        <span class="pcc-num mono">01</span>
        <h3 class="pcc-title">{{t "partnersPage.agencyTitle"}}</h3>
        <p class="pcc-desc">{{t "partnersPage.agencyDesc"}}</p>
      </div>

      <div class="partner-cat-card">
        <span class="pcc-num mono">02</span>
        <h3 class="pcc-title">{{t "partnersPage.techTitle"}}</h3>
        <p class="pcc-desc">{{t "partnersPage.techDesc"}}</p>
      </div>

      <div class="partner-cat-card">
        <span class="pcc-num mono">03</span>
        <h3 class="pcc-title">{{t "partnersPage.logisticsTitle"}}</h3>
        <p class="pcc-desc">{{t "partnersPage.logisticsDesc"}}</p>
      </div>
    </div>

    <!-- Partner Application Form -->
    <div class="partner-apply-section">
      <div class="partner-apply-card center-block">
        <h2 class="pac-title">{{t "partnersPage.applyCta"}}</h2>
        <p class="pac-desc">We are actively building relationships with creative studios, regional logistics providers, and local payment gateways.</p>

        <form id="partner-apply-form" action="/api/contact" method="POST" class="standard-form">
          <input type="hidden" name="lang" value="{{currentLang}}">
          <input type="hidden" name="subject" value="Partner Application">

          <div class="form-row">
            <div class="form-group">
              <label for="partner-name">Contact Name</label>
              <input type="text" id="partner-name" name="name" required autocomplete="name">
            </div>
            <div class="form-group">
              <label for="partner-email">Work Email</label>
              <input type="email" id="partner-email" name="email" required autocomplete="email">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="partner-org">Company / Agency Name</label>
              <input type="text" id="partner-org" name="company" required>
            </div>
            <div class="form-group">
              <label for="partner-type">Partnership Track</label>
              <select id="partner-type" name="partner_type">
                <option value="agency">Design &amp; Development Agency</option>
                <option value="technology">Technology &amp; Integration</option>
                <option value="logistics">Shipping &amp; Logistics</option>
                <option value="other">Other Collaboration</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="partner-message">How would you like to collaborate?</label>
            <textarea id="partner-message" name="message" rows="4" placeholder="Briefly describe your services, typical client profile, or integration proposal..." required></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-large btn-full">
            <span>Submit Partner Application</span>
            <span class="btn-arrow">&rarr;</span>
          </button>

          <div class="form-feedback" id="partner-form-feedback"></div>
        </form>
      </div>
    </div>
  </div>
</div>
