<div class="page-container page-contact">
  <div class="page-header text-center">
    <h1 class="page-title">{{t "contactPage.title"}}</h1>
    <p class="page-lead center-block">{{t "contactPage.lead"}}</p>
  </div>

  <div class="site-container">
    <div class="contact-split-grid">
      <!-- Direct Contact Channels -->
      <div class="contact-channels-side">
        <div class="channel-card">
          <span class="channel-label mono">{{t "contactPage.generalLabel"}}</span>
          <h3 class="channel-heading">support@snaker.store</h3>
          <p class="channel-sub">{{t "contactPage.generalText"}}</p>
        </div>

        <div class="channel-card">
          <span class="channel-label mono">{{t "contactPage.businessLabel"}}</span>
          <h3 class="channel-heading">business@snaker.store</h3>
          <p class="channel-sub">{{t "contactPage.businessText"}}</p>
        </div>

        <div class="channel-card">
          <span class="channel-label mono">{{t "contactPage.responseLabel"}}</span>
          <p class="channel-sub">{{t "contactPage.responseText"}}</p>
        </div>
      </div>

      <!-- Contact Message Form -->
      <div class="contact-form-side">
        <div class="contact-form-card">
          <h2 class="form-title">{{t "contactPage.formTitle"}}</h2>

          <form id="general-contact-form" action="/api/contact" method="POST" class="standard-form" data-loading-text="{{t "forms.loading"}}" data-error-text="{{t "forms.error"}}" data-network-error-text="{{t "forms.networkError"}}">
            <input type="hidden" name="lang" value="{{currentLang}}">

            <div class="form-group">
              <label for="c-name">{{t "forms.name"}}</label>
              <input type="text" id="c-name" name="name" required autocomplete="name">
            </div>

            <div class="form-group">
              <label for="c-email">{{t "forms.email"}}</label>
              <input type="email" id="c-email" name="email" required autocomplete="email">
            </div>

            <div class="form-group">
              <label for="c-subject">{{t "forms.subject"}}</label>
              <input type="text" id="c-subject" name="subject" placeholder="{{t "forms.subjectPlaceholder"}}" required>
            </div>

            <div class="form-group">
              <label for="c-message">{{t "forms.message"}}</label>
              <textarea id="c-message" name="message" rows="4" placeholder="{{t "forms.messagePlaceholder"}}" required></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-large btn-full">
              <span>{{t "forms.send"}}</span>
              <span class="btn-arrow">&rarr;</span>
            </button>

            <div class="form-feedback" id="contact-form-feedback"></div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
