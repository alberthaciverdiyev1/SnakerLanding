<div class="page-container page-demo">
  <div class="page-header text-center">
    <h1 class="page-title">{{t "demoPage.title"}}</h1>
    <p class="page-lead center-block">{{t "demoPage.lead"}}</p>
  </div>

  <div class="site-container">
    <div class="demo-page-wrapper">
      <div class="demo-page-card center-block">
        <form id="demo-page-form" action="/request-demo" method="POST" class="standard-form" data-loading-text="{{t "forms.loading"}}" data-error-text="{{t "forms.error"}}" data-network-error-text="{{t "forms.networkError"}}">
          <input type="hidden" name="lang" value="{{currentLang}}">

          <div class="form-row">
            <div class="form-group">
              <label for="demo-p-name">{{t "demo.nameLabel"}}</label>
              <input type="text" id="demo-p-name" name="name" required autocomplete="name">
            </div>
            <div class="form-group">
              <label for="demo-p-email">{{t "demo.emailLabel"}}</label>
              <input type="email" id="demo-p-email" name="email" required autocomplete="email">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="demo-p-store">{{t "demo.storeLabel"}}</label>
              <input type="text" id="demo-p-store" name="store_name" required>
            </div>
            <div class="form-group">
              <label for="demo-p-website">{{t "demo.websiteLabel"}}</label>
              <input type="text" id="demo-p-website" name="website" placeholder="{{t "demo.websitePlaceholder"}}">
            </div>
          </div>

          <div class="form-group">
            <label for="demo-p-selling">{{t "demo.sellingLabel"}}</label>
            <input type="text" id="demo-p-selling" name="selling_category" placeholder="{{t "demo.sellingPlaceholder"}}">
          </div>

          <div class="form-group">
            <label for="demo-p-message">{{t "demo.messageLabel"}}</label>
            <textarea id="demo-p-message" name="message" rows="3" placeholder="{{t "demo.messagePlaceholder"}}"></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-large btn-full">
            <span>{{t "demo.submitBtn"}}</span>
            <span class="btn-arrow">&rarr;</span>
          </button>

          <div class="form-feedback" id="demo-page-feedback"></div>
        </form>
      </div>
    </div>
  </div>
</div>
