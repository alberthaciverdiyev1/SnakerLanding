<!-- SECTION 1: HERO (Art-Directed Snake with Clean Editorial Typography) -->
<section class="hero-section" id="hero">
  <!-- Art-directed snake background layer -->
  <div class="hero-snake-backdrop" id="hero-snake-backdrop" aria-hidden="true">
    <div class="snake-radial-glow"></div>
    <div class="snake-image-wrapper" id="snake-image-wrapper">
      <img src="/images/snaker-snake.jpg" alt="" class="snake-hero-img" id="snake-hero-img" loading="eager" fetchpriority="high">
    </div>
    <div class="snake-gradient-overlay"></div>
    <div class="hero-cursor-glow" id="hero-cursor-glow"></div>
  </div>

  <div class="hero-container">
    <div class="hero-content">
      <div class="hero-eyebrow" data-entrance="eyebrow">
        <span class="eyebrow-pip"></span>
        <span class="eyebrow-text">{{t "intro.label"}}</span>
      </div>

      <h1 class="hero-headline" data-entrance="headline">
        <span class="reveal-line">
          <span class="reveal-inner">{{t "hero.headlineMain"}}</span>
        </span>
        <span class="reveal-line">
          <span class="reveal-inner highlight-green">{{t "hero.headlineSub"}}</span>
        </span>
      </h1>

      <p class="hero-lead" data-entrance="lead">
        {{t "hero.description"}}
      </p>

      <div class="hero-cta-group" data-entrance="buttons">
        <a href="#pricing" class="btn btn-primary btn-large">
          <span>{{t "hero.primaryCta"}}</span>
          <span class="btn-arrow">&rarr;</span>
        </a>
        <a href="#demo" class="btn btn-secondary btn-large">
          <span>{{t "hero.secondaryCta"}}</span>
        </a>
      </div>

      <div class="hero-subline-pill" data-entrance="reassurance">
        <span class="hero-subline-text">{{t "hero.subtext"}}</span>
      </div>
    </div>
  </div>
</section>

<!-- SECTION 2: EDITORIAL APPROACH & PILLARS -->
<section class="section section-approach" id="solutions">
  <div class="site-container">
    <div class="section-header-editorial text-center" data-reveal>
      <span class="section-tag">{{t "intro.label"}}</span>
      <h2 class="section-title">
        {{t "intro.title"}}
      </h2>
      <p class="section-description center-block">
        {{t "intro.lead"}}
      </p>
    </div>

    <div class="pillars-grid">
      <!-- Pillar 01 -->
      <div class="pillar-card" data-reveal="left">
        <div class="pillar-num-wrap">
          <span class="pillar-num mono">01</span>
        </div>
        <h3 class="pillar-heading">{{t "pillars.simplicityTitle"}}</h3>
        <p class="pillar-body">{{t "pillars.simplicityBody"}}</p>
      </div>

      <!-- Pillar 02 -->
      <div class="pillar-card highlight-pillar" data-reveal="scale">
        <div class="pillar-num-wrap">
          <span class="pillar-num mono">02</span>
        </div>
        <h3 class="pillar-heading">{{t "pillars.affordabilityTitle"}}</h3>
        <p class="pillar-body">{{t "pillars.affordabilityBody"}}</p>
      </div>

      <!-- Pillar 03 -->
      <div class="pillar-card" data-reveal="right">
        <div class="pillar-num-wrap">
          <span class="pillar-num mono">03</span>
        </div>
        <h3 class="pillar-heading">{{t "pillars.autonomyTitle"}}</h3>
        <p class="pillar-body">{{t "pillars.autonomyBody"}}</p>
      </div>
    </div>
  </div>
</section>

<!-- SECTION 3: OPERATIONAL INTERFACE (Realistic Dashboard Preview) -->
<section class="section section-product" id="product">
  <div class="site-container">
    <div class="section-header-editorial text-center" data-reveal>
      <span class="section-tag">{{t "product.label"}}</span>
      <h2 class="section-title">
        {{t "product.title"}}
      </h2>
      <p class="section-description center-block">
        {{t "product.subtitle"}}
      </p>
    </div>

    <!-- Commercial Dashboard Mockup -->
    <div class="dashboard-mockup-wrapper" data-reveal="scale">
      <div class="dashboard-window">
        <!-- Dashboard Top Navigation Bar -->
        <div class="dashboard-topbar">
          <div class="window-controls">
            <span class="win-dot close"></span>
            <span class="win-dot min"></span>
            <span class="win-dot expand"></span>
          </div>
          <div class="dashboard-tabs">
            <span class="dash-tab active">{{t "product.tabOverview"}}</span>
            <span class="dash-tab">{{t "product.tabOrders"}}</span>
            <span class="dash-tab">{{t "product.tabProducts"}}</span>
            <span class="dash-tab">{{t "product.tabCustomers"}}</span>
            <span class="dash-tab">{{t "product.tabThemes"}}</span>
            <span class="dash-tab">{{t "product.tabSettings"}}</span>
          </div>
          <div class="dash-user-badge">
            <span class="user-avatar-initial">S</span>
            <span class="user-store-name">Store Admin</span>
          </div>
        </div>

        <!-- Dashboard Canvas -->
        <div class="dashboard-body">
          <!-- Metric KPI Summary Cards -->
          <div class="dashboard-metrics-grid">
            <div class="metric-card">
              <span class="metric-label">{{t "product.todaySales"}}</span>
              <div class="metric-row">
                <span class="metric-value font-mono">$4,280.00</span>
                <span class="metric-delta positive">+18.4%</span>
              </div>
            </div>
            <div class="metric-card">
              <span class="metric-label">{{t "product.ordersToShip"}}</span>
              <div class="metric-row">
                <span class="metric-value font-mono">12</span>
                <span class="metric-sublabel">Awaiting fulfillment</span>
              </div>
            </div>
            <div class="metric-card">
              <span class="metric-label">{{t "product.payoutStatus"}}</span>
              <div class="metric-row">
                <span class="metric-value font-mono">$1,840.50</span>
                <span class="metric-sublabel">Direct to bank</span>
              </div>
            </div>
          </div>

          <!-- Split Workspace: Orders Table & Inventory Status -->
          <div class="dashboard-workspace-grid">
            <!-- Left: Orders Table -->
            <div class="dash-panel orders-panel">
              <div class="panel-header">
                <h4 class="panel-title">{{t "product.recentOrdersTitle"}}</h4>
                <span class="panel-badge">Live feed</span>
              </div>
              <div class="orders-table-wrapper">
                <table class="dash-table">
                  <thead>
                    <tr>
                      <th>{{t "product.orderNum"}}</th>
                      <th>{{t "product.customer"}}</th>
                      <th>{{t "product.items"}}</th>
                      <th>{{t "product.status"}}</th>
                      <th class="text-right">{{t "product.total"}}</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td class="font-mono">#1084</td>
                      <td>Leyla Aliyeva</td>
                      <td>2 items</td>
                      <td><span class="badge-status status-paid">{{t "product.statusPaid"}}</span></td>
                      <td class="text-right font-mono">$124.00</td>
                    </tr>
                    <tr>
                      <td class="font-mono">#1083</td>
                      <td>Murad Hasanov</td>
                      <td>1 item</td>
                      <td><span class="badge-status status-shipped">{{t "product.statusShipped"}}</span></td>
                      <td class="text-right font-mono">$68.50</td>
                    </tr>
                    <tr>
                      <td class="font-mono">#1082</td>
                      <td>Elvin Mammadov</td>
                      <td>3 items</td>
                      <td><span class="badge-status status-delivered">{{t "product.statusDelivered"}}</span></td>
                      <td class="text-right font-mono">$215.00</td>
                    </tr>
                    <tr>
                      <td class="font-mono">#1081</td>
                      <td>Aysel Karimova</td>
                      <td>1 item</td>
                      <td><span class="badge-status status-paid">{{t "product.statusPaid"}}</span></td>
                      <td class="text-right font-mono">$45.00</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Right: Inventory Status -->
            <div class="dash-panel inventory-panel">
              <div class="panel-header">
                <h4 class="panel-title">{{t "product.stockLevelTitle"}}</h4>
                <span class="panel-badge">Tracked</span>
              </div>
              <div class="inventory-items-list">
                <div class="inv-item">
                  <div class="inv-info">
                    <span class="inv-name">Organic Honey Balm</span>
                    <span class="inv-sku font-mono">SKU-2041</span>
                  </div>
                  <span class="inv-qty in-stock font-mono">48 {{t "product.inStock"}}</span>
                </div>
                <div class="inv-item">
                  <div class="inv-info">
                    <span class="inv-name">Linen Overshirt - Olive</span>
                    <span class="inv-sku font-mono">SKU-1092</span>
                  </div>
                  <span class="inv-qty low-stock font-mono">6 {{t "product.lowStock"}}</span>
                </div>
                <div class="inv-item">
                  <div class="inv-info">
                    <span class="inv-name">Ceramic Pour-over</span>
                    <span class="inv-sku font-mono">SKU-3380</span>
                  </div>
                  <span class="inv-qty in-stock font-mono">32 {{t "product.inStock"}}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- SECTION 4: 3-STEP SETUP / ONBOARDING -->
<section class="section section-steps" id="how-it-works">
  <div class="site-container">
    <div class="section-header-editorial text-center" data-reveal>
      <span class="section-tag">{{t "steps.label"}}</span>
      <h2 class="section-title">
        {{t "steps.title"}}
      </h2>
    </div>

    <div class="steps-timeline" id="steps-timeline">
      <!-- Animated S-curve snake path connecting steps on desktop -->
      <div class="snake-path-tracker" aria-hidden="true">
        <svg class="snake-svg-path" viewBox="0 0 1000 240" fill="none">
          <path id="snake-progress-path" d="M 50,120 C 250,20 400,220 500,120 C 600,20 750,220 950,120" stroke="var(--snake-bright)" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="800" stroke-dashoffset="800" />
        </svg>
      </div>

      <div class="steps-cards-row">
        <!-- Step 1 -->
        <div class="step-card" data-reveal="left">
          <div class="step-badge">
            <span class="step-number mono">{{t "steps.step1Num"}}</span>
          </div>
          <h3 class="step-heading">{{t "steps.step1Title"}}</h3>
          <p class="step-body">{{t "steps.step1Desc"}}</p>
        </div>

        <!-- Step 2 -->
        <div class="step-card highlight-step" data-reveal="scale">
          <div class="step-badge">
            <span class="step-number mono">{{t "steps.step2Num"}}</span>
          </div>
          <h3 class="step-heading">{{t "steps.step2Title"}}</h3>
          <p class="step-body">{{t "steps.step2Desc"}}</p>
        </div>

        <!-- Step 3 -->
        <div class="step-card" data-reveal="right">
          <div class="step-badge">
            <span class="step-number mono">{{t "steps.step3Num"}}</span>
          </div>
          <h3 class="step-heading">{{t "steps.step3Title"}}</h3>
          <p class="step-body">{{t "steps.step3Desc"}}</p>
        </div>
      </div>
    </div>
  </div>
</section>

