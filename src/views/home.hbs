<!-- SECTION 8: OBJECTION-FOCUSED FAQ -->
<section class="section section-faq" id="faq">
  <div class="site-container">
    <div class="section-header-editorial text-center" data-reveal>
      <span class="section-tag">{{t "faq.label"}}</span>
      <h2 class="section-title">
        {{t "faq.title"}}
      </h2>
      <p class="section-description center-block">
        {{t "faq.subtitle"}}
      </p>
    </div>

    <div class="faq-accordion-wrap">
      {{#each faqs}}
      <details class="faq-item" {{#if @first}}open{{/if}} data-reveal>
        <summary class="faq-question">
          <span class="faq-q-text">{{this.q}}</span>
          <span class="faq-icon">&plus;</span>
        </summary>
        <div class="faq-answer">
          <p>{{this.a}}</p>
        </div>
      </details>
      {{/each}}
    </div>
  </div>
</section>

<!-- SECTION 9: DEDICATED DEMO REQUEST -->
<section class="section section-demo" id="demo">
  <div class="site-container">
    <div class="demo-split-grid" data-reveal>
      <!-- Left Info Column -->
      <div class="demo-info-col">
        <span class="section-tag mono">{{t "demo.label"}}</span>
        <h2 class="demo-title">
          {{t "demo.title"}}
        </h2>
        <p class="demo-desc">
          {{t "demo.description"}}
        </p>

        <div class="demo-feature-checks">
          <div class="df-check">
            <span class="df-icon">&check;</span>
            <div class="df-text">
              <strong>{{t "storefronts.title"}}</strong>
              <span>{{t "storefronts.description"}}</span>
            </div>
          </div>
          <div class="df-check">
            <span class="df-icon">&check;</span>
            <div class="df-text">
              <strong>{{t "pillars.simplicityTitle"}}</strong>
              <span>{{t "pillars.simplicityBody"}}</span>
            </div>
          </div>
          <div class="df-check">
            <span class="df-icon">&check;</span>
            <div class="df-text">
              <strong>{{t "pillars.affordabilityTitle"}}</strong>
              <span>{{t "pillars.affordabilityBody"}}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Demo Form Column -->
      <div class="demo-form-col">
        <div class="demo-form-card">
          <h3 class="form-card-title">{{t "demo.title"}}</h3>
          <p class="form-card-sub">{{t "demo.description"}}</p>

          <form class="demo-form" id="demo-request-form" action="/request-demo" method="POST">
            <input type="hidden" name="lang" value="{{currentLang}}">

            <div class="form-group">
              <label for="demo-name">{{t "demo.nameLabel"}}</label>
              <input type="text" id="demo-name" name="name" required autocomplete="name">
            </div>

            <div class="form-group">
              <label for="demo-email">{{t "demo.emailLabel"}}</label>
              <input type="email" id="demo-email" name="email" required autocomplete="email">
            </div>

            <div class="form-group">
              <label for="demo-store">{{t "demo.storeLabel"}}</label>
              <input type="text" id="demo-store" name="store_name" required>
            </div>

            <div class="form-group">
              <label for="demo-selling">{{t "demo.sellingLabel"}}</label>
              <input type="text" id="demo-selling" name="selling_category">
            </div>

            <div class="form-group">
              <label for="demo-website">{{t "demo.websiteLabel"}}</label>
              <input type="text" id="demo-website" name="website">
            </div>

            <button type="submit" class="btn btn-primary btn-large btn-full demo-submit-btn">
              <span>{{t "demo.submitBtn"}}</span>
              <span class="btn-arrow">&rarr;</span>
            </button>

            <div class="form-feedback" id="demo-form-feedback" aria-live="polite"></div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- SECTION 10: FINAL CLOSING CALL TO ACTION BANNER -->
<section class="section section-final-banner" id="start">
  <div class="site-container">
    <div class="banner-panel" data-reveal>
      <div class="banner-snake-crop" aria-hidden="true">
        <img src="/images/snaker-snake.jpg" alt="" class="banner-snake-img" loading="lazy">
        <div class="banner-snake-mask"></div>
      </div>

      <div class="banner-content">
        <span class="section-tag mono">{{t "intro.label"}}</span>
        <h2 class="banner-heading">
          {{t "cta.title"}}
        </h2>
        <p class="banner-lead">
          {{t "cta.description"}}
        </p>
        <div class="banner-actions">
          <a href="#pricing" class="btn btn-primary btn-large">
            <span>{{t "cta.primary"}}</span>
            <span class="btn-arrow">&rarr;</span>
          </a>
          <a href="#demo" class="btn btn-secondary btn-large">
            <span>{{t "cta.secondary"}}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
