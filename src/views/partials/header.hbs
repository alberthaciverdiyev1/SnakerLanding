<header class="site-header" id="site-header">
  <div class="header-container">
    <a href="/{{currentLang}}" class="brand-logo" aria-label="Snaker Home">
      <span class="logo-symbol">
        <svg width="24" height="24" viewBox="0 0 40 40" fill="none" aria-hidden="true">
          <path class="snake-path" d="M8 32 C8 24 16 22 20 20 C24 18 32 16 32 8" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
          <path class="snake-path-glow" d="M12 32 C12 26 18 24 22 22 C26 20 30 18 30 14" stroke="var(--brand-bright)" stroke-width="2" stroke-linecap="round" opacity="0.85"/>
          <circle class="snake-eye-mark" cx="32" cy="8" r="2.5" fill="var(--snake-eye)"/>
        </svg>
      </span>
      <span class="logo-text">SNAKER</span>
    </a>

    <nav class="main-nav" id="main-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        <li><a href="/{{currentLang}}#product" class="nav-link">{{t "nav.product"}}</a></li>
        <li><a href="/{{currentLang}}/themes" class="nav-link {{#if (eq currentPath '/themes')}}active{{/if}}">{{t "nav.themes"}}</a></li>
        <li><a href="/{{currentLang}}/pricing" class="nav-link {{#if (eq currentPath '/pricing')}}active{{/if}}">{{t "nav.pricing"}}</a></li>
        <li><a href="/{{currentLang}}/business" class="nav-link {{#if (eq currentPath '/business')}}active{{/if}}">{{t "nav.business"}}</a></li>
      </ul>

      <!-- Mobile Controls Drawer -->
      <div class="mobile-nav-footer">
        <div class="mobile-lang-row">
          <span class="mobile-control-label">Language:</span>
          <div class="mobile-lang-links">
            {{#each languages}}
            <a href="{{this.url}}" class="lang-code-link {{#if this.active}}active{{/if}}">{{this.label}}</a>
            {{/each}}
          </div>
        </div>

        <div class="mobile-theme-row">
          <span class="mobile-control-label">Theme:</span>
          <button class="theme-toggle-btn mobile-theme-btn" id="mobile-theme-toggle" aria-label="Toggle theme">
            <span class="theme-label-dark">Dark</span> / <span class="theme-label-light">Light</span>
          </button>
        </div>
      </div>
    </nav>

    <div class="header-actions">
      <!-- Theme Switcher (Minimal SVG, No Emojis) -->
      <button class="theme-toggle-btn" id="theme-toggle" aria-label="Toggle light and dark mode">
        <svg class="theme-icon icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg class="theme-icon icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
      </button>

      <!-- Desktop Language Selector (Preserves current page) -->
      <div class="lang-selector-group" aria-label="Language Selector">
        {{#each languages}}
        <a href="{{this.url}}" class="lang-link {{#if this.active}}active{{/if}}" aria-label="{{this.name}}">{{this.label}}</a>
        {{/each}}
      </div>

      <a href="/{{currentLang}}/demo" class="btn btn-ghost header-signin-link">{{t "nav.demo"}}</a>
      <a href="/{{currentLang}}/pricing" class="btn btn-primary btn-nav-cta">
        <span>{{t "nav.createStore"}}</span>
      </a>

      <button class="mobile-toggle" id="mobile-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>
</header>
