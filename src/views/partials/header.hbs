<header class="site-header" id="site-header">
  <div class="header-container">
    <a href="/{{currentLang}}" class="brand-logo" aria-label="Snaker Home">
      <span class="logo-symbol">
        <svg width="24" height="24" viewBox="0 0 40 40" fill="none" aria-hidden="true">
          <path class="snake-path" d="M8 32 C8 24 16 22 20 20 C24 18 32 16 32 8" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
          <path class="snake-path-glow" d="M12 32 C12 26 18 24 22 22 C26 20 30 18 30 14" stroke="var(--snake-bright)" stroke-width="2.5" stroke-linecap="round" opacity="0.8"/>
          <circle class="snake-eye-mark" cx="32" cy="8" r="2.8" fill="var(--snake-eye)"/>
        </svg>
      </span>
      <span class="logo-text">SNAKER</span>
    </a>

    <nav class="main-nav" id="main-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        <li><a href="#product" class="nav-link">{{t "nav.product"}}</a></li>
        <li><a href="#solutions" class="nav-link">{{t "nav.solutions"}}</a></li>
        <li><a href="#storefronts" class="nav-link">{{t "nav.themes"}}</a></li>
        <li><a href="#pricing" class="nav-link">{{t "nav.pricing"}}</a></li>
        <li><a href="#faq" class="nav-link">{{t "nav.faq"}}</a></li>
      </ul>

      <!-- Mobile language switch inside mobile nav -->
      <div class="mobile-lang-switch">
        <span class="mobile-lang-label">Language:</span>
        <div class="mobile-lang-links">
          {{#each languages}}
          <a href="{{this.url}}" class="lang-code-link {{#if this.active}}active{{/if}}">{{this.label}}</a>
          {{/each}}
        </div>
      </div>
    </nav>

    <div class="header-actions">
      <!-- Desktop Language Selector -->
      <div class="lang-selector-group" aria-label="Language Selector">
        {{#each languages}}
        <a href="{{this.url}}" class="lang-link {{#if this.active}}active{{/if}}">{{this.label}}</a>
        {{/each}}
      </div>

      <a href="#demo" class="btn btn-ghost">{{t "nav.signIn"}}</a>
      <a href="#pricing" class="btn btn-primary btn-nav-cta">
        <span>{{t "nav.createStore"}}</span>
      </a>

      <button class="mobile-toggle" id="mobile-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>
</header>
